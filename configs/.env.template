# ── Proxy Auth ───────────────────────────────────
LITELLM_MASTER_KEY="sk-change-me"
LITELLM_SALT_KEY="change-me-to-a-long-random-string"

# ── Database ─────────────────────────────────────
DB_PASSWORD="change-me-to-a-strong-password"

# ── Grafana ──────────────────────────────────────
GRAFANA_ADMIN_PASSWORD="change-me-to-a-strong-password"

# ── Prometheus ───────────────────────────────────
PROMETHEUS_RETENTION="30d"

# ── Huawei MaaS ──────────────────────────────────
# Mandatory main API key (from ModelArts MaaS console, ap-southeast-1):
HUAWEI_MAAS_API_KEY="change-me-to-your-maas-api-key"
# ── The following are written by 01_env.sh — do not edit manually ──
# HUAWEI_MAAS_API_KEY_COUNT=1
# HUAWEI_MAAS_API_KEY_0="..."
# HUAWEI_MAAS_API_KEY_1="..."
HUAWEI_MAAS_API_BASE="https://api-ap-southeast-1.modelarts-maas.com/openai/v1"

# ── Huawei MaaS Anthropic Endpoint ───────────────
# Anthropic-compatible endpoint for Claude Code CLI (model-call-022.html)
HUAWEI_MAAS_ANTHROPIC_API_BASE="https://api-ap-southeast-1.modelarts-maas.com/anthropic"

# ── Bind Address ──────────────────────────────────
# 127.0.0.1 = localhost only (default, secure). 0.0.0.0 = all interfaces (remote access).
BIND_ADDRESS="127.0.0.1"

# ── opencode Websearch ───────────────────────────
# Enable EXA-backed websearch for custom providers (LiteLLM/Huawei-MaaS).
# Not needed when using the default OpenCode provider.
OPENCODE_ENABLE_EXA=1

# ── Note: Virtual keys are minted by 03a-03d scripts and stored in tool
#    config files (~/.config/opencode/, ~/.codex/, ~/.claude/, ~/.pi/),
#    not in this .env file.
