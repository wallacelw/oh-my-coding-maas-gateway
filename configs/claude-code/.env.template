# ─────────────────────────────────────────────────────────────────────────────
# Claude Code CLI Config Template
#
# Claude Code CLI uses the Anthropic Messages API (/v1/messages).
# LiteLLM forwards to Huawei MaaS's Anthropic-compatible endpoint
# (/anthropic/v1/messages) via anthropic/ provider deployments in config.yaml.
#
# Model names are prefixed with claude- to avoid routing conflicts with
# OpenAI deployments that share the same base name. LiteLLM routes by
# model_name, so claude-glm-5.3 always hits the anthropic/ deployment
# (direct to Huawei MaaS Anthropic endpoint, no OpenAI conversion).
#
# Config is written to ~/.claude/settings.json (Claude Code's native settings
# file) using the env block plus modelOverrides/modelPicker. No shell exports
# or source needed — Claude Code reads this file automatically on startup.
#
# Claude Code only recognizes model IDs it knows, or IDs that appear as VALUES
# in modelOverrides — unknown claude-* IDs hit the unrecognized-model path
# (per-session warnings, version-dependent refusals). The [1m]-anchored
# overrides make the gateway's IDs recognized while every request still
# carries the gateway's model name; the alias vars repoint opus/sonnet/haiku
# at the gateway's models; discovery lists every claude-* model in /model.
#
# The actual settings.json content (JSON, not shell):
# {
#   "env": {
#     "ANTHROPIC_BASE_URL": "http://127.0.0.1:4000",
#     "ANTHROPIC_API_KEY": "sk-...",
#     "ANTHROPIC_MODEL": "claude-glm-5.3",
#     "ANTHROPIC_SMALL_FAST_MODEL": "claude-deepseek-v4.1-flash-1017",
#     "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-glm-5.3",
#     "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-glm-5.3",
#     "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-deepseek-v4.1-flash-1017",
#     "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1",
#     "CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL": "1"
#   },
#   "modelOverrides": {
#     "claude-sonnet-4-5[1m]": "claude-glm-5.3",
#     "claude-haiku-4-5[1m]": "claude-deepseek-v4.1-flash-1017"
#   },
#   "modelPicker": {
#     "options": [
#       { "model": "claude-glm-5.3", "label": "GLM 5.3 (LiteLLM)",
#         "description": "Flagship reasoning model via the LiteLLM gateway",
#         "behavesAs": "claude-sonnet-4-5[1m]" },
#       { "model": "claude-deepseek-v4.1-flash-1017", "label": "DeepSeek Flash (LiteLLM)",
#         "description": "Fast model via the LiteLLM gateway",
#         "behavesAs": "claude-haiku-4-5[1m]" }
#     ]
#   }
# }
#
# VSCode extension auto-install is also disabled via ~/.claude.json:
# {
#   "autoInstallIdeExtension": false
# }
# ─────────────────────────────────────────────────────────────────────────────
